{
  "name": "clefsmith",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "arch": "tools/arch/node_modules/.bin/depcruise src",
    "deadcode": "knip",
    "e2e": "cd e2e && bun run e2e",
    "e2e:check": "cd e2e && bun run check:conventions",
    "postinstall": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks; cd tools/arch && bun install && cd ../../e2e && bun install"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "inversify": "^8.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "reflect-metadata": "~0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "knip": "^6.43.0",
    "typescript": "~7.0.2"
  }
}
