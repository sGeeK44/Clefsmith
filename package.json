{
  "name": "clefsmith",
  "version": "1.1.1",
  "main": "expo-router/entry",
  "private": true,
  "imports": {
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "biome check --no-errors-on-unmatched",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "arch": "tools/arch/node_modules/.bin/depcruise src",
    "deadcode": "knip",
    "bench": "bun bench/run.ts",
    "e2e": "cd e2e && bun run e2e",
    "e2e:check": "cd e2e && bun run check:conventions",
    "postinstall": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks; cd tools/arch && bun install && cd ../../e2e && bun install"
  },
  "dependencies": {
    "@expo-google-fonts/noto-music": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.19",
    "expo-asset": "^58.0.19",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "^58.0.7",
    "expo-file-system": "^58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-system-ui": "~58.0.6",
    "inversify": "^8.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-unistyles": "3.5.3",
    "react-native-vosk": "2.1.7",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "reflect-metadata": "~0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "knip": "^6.43.0",
    "typescript": "~7.0.2"
  },
  "patchedDependencies": {
    "react-native-vosk@2.1.7": "patches/react-native-vosk@2.1.7.patch"
  }
}
